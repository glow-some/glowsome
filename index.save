  <footer class="site-footer">

    <div class="footer-top container">

      <div class="footer-links">

        <a
          href="#about"
          data-page="about"
        >
          Lucie Rust
        </a>

        <a
          href="#glowie"
          data-page="glowie"
        >
          Glowie
        </a>

        <a
          href="#reconnection"
          data-page="reconnection"
        >
          Reconnection Project
        </a>

        <a
          href="#contact"
          data-page="contact"
        >
          Contact
        </a>

        <a
          href="#privacy"
          data-page="privacy"
        >
          Privacy Policy
        </a>

        <a
          href="#terms"
          data-page="terms"
        >
          Terms of Service
        </a>

      </div>


      <p class="footer-copyright">
        © 2026 Glowsome Relationships
      </p>

    </div>


    <div
      class="footer-word"
      aria-hidden="true"
    >
      glowsome
    </div>

  </footer>


  <script>

    const validPages = [
      "home",
      "glowie",
      "about",
      "reconnection",
      "contact",
      "privacy",
      "terms"
    ];


    const scenes =
      document.querySelectorAll("[data-scene]");

    const pageLinks =
      document.querySelectorAll("[data-page]");

    const menuButton =
      document.getElementById("menuButton");

    const siteHeader =
      document.getElementById("siteHeader");


    function closeMenu() {
      document.body.classList.remove("menu-open");

      const mobileMenu =
        document.getElementById("mobileMenu");

      if (mobileMenu) {
        mobileMenu.setAttribute("aria-hidden", "true");
      }

      if (menuButton) {
        menuButton.setAttribute(
          "aria-expanded",
          "false"
        );

        menuButton.setAttribute(
          "aria-label",
          "Open navigation"
        );
      }
    }


    function openMenu() {
      document.body.classList.add("menu-open");

      const mobileMenu =
        document.getElementById("mobileMenu");

      if (mobileMenu) {
        mobileMenu.setAttribute("aria-hidden", "false");
      }

      if (menuButton) {
        menuButton.setAttribute(
          "aria-expanded",
          "true"
        );

        menuButton.setAttribute(
          "aria-label",
          "Close navigation"
        );
      }
    }


    function toggleMenu() {
      if (
        document.body.classList.contains(
          "menu-open"
        )
      ) {
        closeMenu();
      } else {
        openMenu();
      }
    }


    function updateActiveNavigation(pageName) {

      pageLinks.forEach((link) => {

        if (
          link.dataset.page === pageName
        ) {
          link.classList.add("active");
        } else {
          link.classList.remove("active");
        }

      });

    }


    function showPage(
      pageName,
      updateHistory = true
    ) {

      const nextPage =
        validPages.includes(pageName)
          ? pageName
          : "home";


      scenes.forEach((scene) => {

        if (
          scene.dataset.scene === nextPage
        ) {
          scene.classList.add("active");
        } else {
          scene.classList.remove("active");
        }

      });


      updateActiveNavigation(nextPage);

      closeMenu();


      if (updateHistory) {

        const nextHash =
          `#${nextPage}`;

        if (
          window.location.hash !== nextHash
        ) {
          history.pushState(
            { page: nextPage },
            "",
            nextHash
          );
        }

      }


      const reduceMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

      window.scrollTo({
        top: 0,
        behavior: reduceMotion ? "auto" : "smooth"
      });

    }


    pageLinks.forEach((link) => {

      link.addEventListener(
        "click",
        (event) => {

          const pageName =
            link.dataset.page;

          if (!pageName) {
            return;
          }

          event.preventDefault();

          showPage(pageName);

        }
      );

    });


    if (menuButton) {

      menuButton.addEventListener(
        "click",
        toggleMenu
      );

    }


    window.addEventListener(
      "popstate",
      () => {

        const hash =
          window.location.hash
            .replace("#", "");

        const pageName =
          validPages.includes(hash)
            ? hash
            : "home";

        showPage(
          pageName,
          false
        );

      }
    );


    function loadInitialPage() {

      const hash =
        window.location.hash
          .replace("#", "");

      const initialPage =
        validPages.includes(hash)
          ? hash
          : "home";

      showPage(
        initialPage,
        false
      );

    }


    function handleHeader() {

      if (!siteHeader) {
        return;
      }

      if (window.scrollY > 20) {
        siteHeader.classList.add(
          "scrolled"
        );
      } else {
        siteHeader.classList.remove(
          "scrolled"
        );
      }

    }


    window.addEventListener(
      "scroll",
      handleHeader,
      { passive: true }
    );


    window.addEventListener(
      "resize",
      () => {
        if (
          window.innerWidth > 1050 &&
          document.body.classList.contains(
            "menu-open"
          )
        ) {
          closeMenu();
        }
      },
      { passive: true }
    );


    handleHeader();


    document
      .querySelectorAll(
        "[data-email-signup]"
      )
      .forEach((form) => {

        form.addEventListener(
          "submit",
          (event) => {

            event.preventDefault();

            if (!form.reportValidity()) {
              return;
            }

            const emailInput =
              form.querySelector(
                'input[type="email"]'
              );

            const feedback =
              form.parentElement.querySelector(
                ".notify-feedback"
              );

            if (!emailInput) {
              return;
            }

            const email =
              emailInput.value.trim();

            const subject =
              encodeURIComponent(
                "Glowie updates signup"
              );

            const body =
              encodeURIComponent(
                `Please add ${email} to the Glowie updates list.`
              );

            if (feedback) {
              feedback.textContent =
                "Your email app will open so you can confirm your request.";
            }

            window.location.href =
              `mailto:glowie@glowsome.com?subject=${subject}&body=${body}`;

          }
        );

      });


    loadInitialPage();

  </script>

</body>
</html>
